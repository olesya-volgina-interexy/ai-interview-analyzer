{
  "name": "@app/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @shared/schemas build && prisma generate && tsc && tsc-alias",
    "start": "pnpm prisma migrate deploy && node dist/index.js",
    "migrate:incoming": "tsx src/scripts/migrate-incoming-requests.ts",
    "backfill:clients": "tsx src/scripts/backfill-clients.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/env": "^4.3.0",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^8.1.1",
    "@linear/sdk": "^26.0.0",
    "@prisma/client": "^5.15.0",
    "@qdrant/js-client-rest": "^1.11.0",
    "@shared/schemas": "workspace:*",
    "axios": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "dotenv": "^17.3.1",
    "fastify": "^4.28.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.1",
    "openai": "^4.52.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.40.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^5.15.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}